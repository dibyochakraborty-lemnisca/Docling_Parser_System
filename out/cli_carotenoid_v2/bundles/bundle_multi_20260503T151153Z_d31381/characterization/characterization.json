      ],
      "confidence": 0.85,
      "extraction_model": "gemini-3.1-pro-preview"
    },
    {
      "narrative_id": "2f958056-4c87-438b-b065-502726122483:N-0003",
      "tag": "closure_event",
      "text": "Cultivation was completed at 96 h as planned; however, white cells and partial cell death were observed during the later stages of the run.",
      "source_locator": {
        "page": 5,
        "section": "narrative",
        "paragraph_index": 42,
        "char_offset": null
      },
      "run_id": "BATCH-02",

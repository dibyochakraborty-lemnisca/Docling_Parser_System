      "confidence": 0.85,
      "extraction_model": "gemini-3.1-pro-preview"
    },
    {
      "narrative_id": "2f958056-4c87-438b-b065-502726122483:N-0005",
      "tag": "closure_event",
      "text": "Cultivation was ended at 74 h; toward the end of the run, white cells and signs of cell death were observed, indicating persistent pigment instability in late phase.",

      "confidence": 0.85,
      "extraction_model": "gemini-3.1-pro-preview"
    },
    {
      "narrative_id": "2f958056-4c87-438b-b065-502726122483:N-0004",
      "tag": "closure_event",
      "text": "Cultivation was terminated at 84 h due to onset of pigment loss (white cells) and signs of cell death observed during centrifugation.",

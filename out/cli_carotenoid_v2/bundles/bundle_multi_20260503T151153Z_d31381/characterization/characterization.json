    {
      "narrative_id": "2f958056-4c87-438b-b065-502726122483:N-0002",
      "tag": "observation",
      "text": "During the initial batch phase, exponential growth was observed as the yeast utilized the available nutrients in the batch medium.",
      "source_locator": {
        "page": 3,
        "section": "narrative",
        "paragraph_index": 28,
        "char_offset": null
      },
      "run_id": "BATCH-01",

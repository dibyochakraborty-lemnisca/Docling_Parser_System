# FASSO local configuration
#
# Copy this file to .env, fill in the values you need, then either run tools
# that load .env themselves or export it in your shell:
#
#   set -a; source .env; set +a
#
# For a fresh setup, see SETUP.md.

# ===========================================================================
# Required for any live run
# ===========================================================================

# Required for raw CSV/XLSX/PDF ingest. Bundle-only hypothesis runs do not
# need Postgres.
DATABASE_URL=postgresql+psycopg://fermdocs:fermdocs@localhost:5432/fermdocs

# Gemini API key — the live hypothesis path uses Gemini.
GEMINI_API_KEY=

# ===========================================================================
# Memory layer (optional but recommended)
# ===========================================================================
# Enables cross-run priors. Persists distilled lessons keyed by
# process_family; injects them into the synthesizer/critic on the next
# run on the same family. Memory is opt-in and gated on a closed-vocab
# process_family (operators pick from the upload UI dropdown).

# Memory backend selector: noop (default; memory off) | synap (live).
# When set to synap, requires SYNAP_API_KEY below.
FERMDOCS_MEMORY=noop

# Synap API key. Sign up at https://synap.maximem.ai for a free tier.
# Only required when FERMDOCS_MEMORY=synap.
SYNAP_API_KEY=

# Optional: pin a specific Synap instance. When blank, the SDK resolves
# the instance from the API key via whoami.
# SYNAP_INSTANCE_ID=

# Tenant scope for memory records. Used as Synap's customer_id. Default
# "default" for single-tenant deploys. For multi-customer prod, set this
# per-deployment (e.g. lemnisca-internal, acme-bio, ...).
FERMDOCS_TENANT_ID=default

# ===========================================================================
# Local storage
# ===========================================================================

# Where original source files are stored during ingest.
FERMDOCS_DATA_DIR=./data

# Local API output root: uploads, runs, bundles, and intermediate files.
FERMDOCS_API_ROOT=out/api

# Useful when API subprocesses are launched from another working directory.
# FERMDOCS_REPO_ROOT=/absolute/path/to/fermdocs

# Optional: override the bundled golden schema YAML.
# FERMDOCS_SCHEMA_PATH=/path/to/golden_schema.yaml

# Optional: process prior/registry overrides.
# FERMDOCS_PRIORS_PATH=/path/to/process_priors.yaml
# FERMDOCS_PROCESS_REGISTRY_PATH=/path/to/process_registry.yaml

# ===========================================================================
# Provider keys
# ===========================================================================

# Already set above for the live path:
# GEMINI_API_KEY=

# Optional — Anthropic support exists for some earlier stages.
ANTHROPIC_API_KEY=

# ===========================================================================
# Ingest: mapper, identity, PDF segmentation, units, narrative extraction
# ===========================================================================

# Mapper provider: gemini | anthropic | fake
FERMDOCS_MAPPER_PROVIDER=gemini
FERMDOCS_GEMINI_MODEL=gemini-3-flash

# Anthropic mapper model, used only for FERMDOCS_MAPPER_PROVIDER=anthropic.
# FERMDOCS_MAPPER_MODEL=claude-haiku-4-5-20251001

# Identity extractor provider/model. Defaults to mapper provider, then gemini.
# Use provider fake/none from the CLI to skip identity extraction.
# Identity extractor now emits a closed-vocab process_family from
# process_families.yaml.
# FERMDOCS_IDENTITY_PROVIDER=gemini
# FERMDOCS_IDENTITY_MODEL=gemini-3-flash

# PDF OCR is off by default. Enable only for image-based PDFs.
FERMDOCS_PDF_OCR=false

# LLM-driven PDF document segmentation. Splits multi-batch PDFs into per-run
# trajectories when possible.
FERMDOCS_PDF_SEGMENT=true
# FERMDOCS_SEGMENTER_PROVIDER=gemini
# FERMDOCS_SEGMENTER_MODEL=gemini-3-pro

# Rule-based unit normalization is always on. This flag controls only the LLM
# fallback for unit strings pint cannot parse.
FERMDOCS_USE_LLM_NORMALIZER=true
# FERMDOCS_NORMALIZER_PROVIDER=gemini

# Narrative extraction has two layers:
# - residual prose capture: unconditional preservation
# - typed LLM extraction: controlled by these flags
FERMDOCS_EXTRACT_NARRATIVE=true
FERMDOCS_EXTRACT_NARRATIVE_INSIGHTS=true
# FERMDOCS_NARRATIVE_PROVIDER=gemini
# FERMDOCS_NARRATIVE_MODEL=gemini-3-pro

# ===========================================================================
# Characterization, diagnosis, hypothesis
# ===========================================================================

# Characterization is deterministic-first. If a Gemini client can be built,
# the optional trajectory analyzer is enabled unless the CLI disables it.
FERMDOCS_CHARACTERIZE_PROVIDER=gemini
# FERMDOCS_CHARACTERIZE_MODEL=gemini-3-pro

# Diagnosis supports Gemini and Anthropic clients. fake/none can be selected
# from the CLI for an explicit no-LLM error-path run.
FERMDOCS_DIAGNOSIS_PROVIDER=gemini
# FERMDOCS_DIAGNOSIS_MODEL=gemini-3-pro

# Hypothesis live execution currently uses Gemini.
FERMDOCS_HYPOTHESIS_PROVIDER=gemini
# FERMDOCS_HYPOTHESIS_MODEL=gemini-3-pro

# User-question classifier.
# FERMDOCS_QUESTION_CLASSIFIER_MODEL=gemini-3-flash

# ===========================================================================
# Local API
# ===========================================================================

FERMDOCS_API_HOST=127.0.0.1
FERMDOCS_API_PORT=8000
# FERMDOCS_API_RELOAD=1

# ===========================================================================
# Debug output
# ===========================================================================

# Set any of these to a non-empty value to print provider payload/debug data.
# FERMDOCS_DEBUG_MAPPER=1
# FERMDOCS_DEBUG_IDENTITY=1
# FERMDOCS_DEBUG_SEGMENTER=1
# FERMDOCS_DEBUG_CHARACTERIZE=1
# FERMDOCS_DEBUG_DIAGNOSIS=1
# FERMDOCS_DEBUG_HYPOTHESIS=1
